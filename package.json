{
	"name": "obsidian-clearsync",
	"version": "0.1.0",
	"description": "End-to-end encrypted, conflict-aware vault sync for Obsidian.",
	"license": "MIT",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"coverage": "vitest run --coverage",
		"lint": "eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@types/node": "^26.2.0",
		"@vitest/coverage-v8": "^4.1.10",
		"builtin-modules": "^5.3.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.8.1",
		"obsidian": "^1.13.1",
		"prettier": "^3.9.6",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.67.0",
		"vitest": "^4.1.10"
	}
}
